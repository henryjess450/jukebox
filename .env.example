# ---------------------------------------------------------------------------
# Jukebox configuration. Copy to .env and fill in.
# Everything here is a secret or a deployment fact. Behaviour that an operator
# changes day to day lives in the admin panel, not in this file.
# ---------------------------------------------------------------------------

NODE_ENV=production
LOG_LEVEL=info

# Bind address. Keep 127.0.0.1 when Cloudflare Tunnel fronts the app; the
# tunnel connects outbound and nothing needs to be exposed on the LAN.
HOST=127.0.0.1
PORT=8080

# The URL guests actually reach. Must match the Spotify redirect URI you
# register, and is used to build Stripe's return URLs. No trailing slash.
#
# Spotify rejects "localhost" as a redirect URI, and rejects plain HTTP for
# anything that is not a loopback literal. So:
#   real deployment  ->  https://jukebox.example.com
#   local testing    ->  http://127.0.0.1:8080     (NOT http://localhost:8080)
# This app refuses to boot on a value that breaks either rule.
PUBLIC_URL=https://jukebox.example.com

DATABASE_PATH=/var/lib/jukebox/jukebox.db

# Signs session cookies. Generate with:
#   openssl rand -base64 48
COOKIE_SECRET=

# Admin password, bcrypt-hashed. There is no default and no fallback — the
# process refuses to start without it. Generate with:
#   npm run hash-password
#
# KEEP THE SINGLE QUOTES. A bcrypt hash contains `$`, and Docker Compose reads
# an unquoted `$NAME` here as a variable to substitute — the container would
# get a mangled hash and refuse to start. Quote any value containing `$`.
ADMIN_PASSWORD_HASH=''

# ---------------------------------------------------------------------------
# Spotify — https://developer.spotify.com/dashboard
# Register the redirect URI as exactly: <PUBLIC_URL>/admin/spotify/callback
# (see the "Creating the Spotify app" section of DEPLOY.md)
# The account you authorize must have Premium; the Web API cannot control
# playback on a free account.
# ---------------------------------------------------------------------------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Stripe — optional until you turn off free mode.
#
# Use a test key (sk_test_...) until the whole flow works. The publishable key
# is not needed: checkout is hosted by Stripe and no card field exists here.
#
# STRIPE_WEBHOOK_SECRET is only needed if you expose the webhook endpoint
# through the tunnel. The primary confirmation path is a server-side session
# lookup when the guest returns, which works behind NAT with no webhook at all.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Docker / host facts. Read by docker-compose.yml, not by the app itself.
# ---------------------------------------------------------------------------

# The host's audio group id, so the containers may open the sound card.
#   getent group audio | cut -d: -f3
AUDIO_GID=29

# Must match the "Connect device name" in the admin panel, exactly. This is the
# name librespot advertises on the network and the only stable way to find it:
# the Spotify device id changes on every librespot restart.
DEVICE_NAME=Control Box - Player

# ALSA output device. `default` is usually right; if the analog jack is not
# card 0, use something like hw:1,0 — see the ALSA section of the README.
ALSA_DEVICE=default

# Cloudflare Tunnel token, only needed with docker-compose.tunnel.yml.
# Cloudflare Zero Trust dashboard -> Networks -> Tunnels -> your tunnel.
TUNNEL_TOKEN=
